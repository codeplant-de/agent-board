{
  "boardId": "REPLACE_WITH_BOARD_ID_OR_SHORT_LINK",
  "maxParallel": 2,
  "timeoutMinutes": 45,
  "slackWebhookFile": "~/.config/watch-review-requests/slack-webhook",
  "intakeLabel": "review-pr",
  "repos": {
    "cosuno/cosuno": "~/workspace/cosuno/cosuno"
  },
  "labels": {
    "review-pr": {
      "skill": "board-review-pr",
      "cwd": "pr-repo",
      "allowedTools": [
        "Read",
        "Grep",
        "Glob",
        "Skill",
        "Agent",
        "Write(//tmp/pr-*)",
        "Bash(board *)",
        "Bash(*/pr-review/skills/*/review-notes.sh *)",
        "Bash(*/pr-review/skills/*/draft-review.sh validate *)",
        "Bash(*/pr-review/skills/*/draft-review.sh lint *)",
        "Bash(*/pr-review/skills/*/draft-review.sh append *)",
        "Bash(*/pr-review/skills/*/draft-review.sh edit *)",
        "Bash(*/pr-review/skills/*/draft-review.sh remove *)",
        "Bash(*/pr-review/skills/*/pr-comments.sh *)",
        "Bash(gh pr view *)",
        "Bash(gh pr diff *)",
        "Bash(gh pr checks *)",
        "Bash(gh search *)",
        "Bash(git log *)",
        "Bash(git show *)",
        "Bash(git diff *)",
        "Bash(git cat-file *)",
        "Bash(git ls-tree *)",
        "Bash(git merge-base *)",
        "Bash(git rev-parse *)",
        "Bash(git fetch origin *)",
        "Bash(jq *)",
        "Bash(brain notes append *)",
        "mcp__shortcut__get_story"
      ],
      "disallowedTools": [
        "Bash(gh api *)",
        "Bash(gh pr review *)",
        "Bash(gh pr comment *)",
        "Bash(gh pr merge *)",
        "Bash(gh pr close *)",
        "Bash(gh pr edit *)",
        "Bash(gh pr ready *)",
        "Bash(git push *)",
        "Bash(git commit *)",
        "Bash(git checkout *)",
        "Bash(git switch *)",
        "Bash(git worktree *)",
        "Bash(*/pr-review/skills/*/draft-review.sh create *)",
        "Bash(*/pr-review/skills/*/draft-review.sh replace *)",
        "Bash(*/pr-review/skills/*/draft-review.sh delete *)"
      ]
    },
    "selftest": {
      "command": ["sleep", "300"]
    },
    "selftest-fail": {
      "command": ["sh", "-c", "echo about to fail; exit 1"]
    }
  }
}
