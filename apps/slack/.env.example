# App-level token of the Slack app (scope connections:write), xapp-…
SLACK_APP_TOKEN=
# Bot User OAuth Token (xoxb-…), optional: without it the Send to board shortcut is off and /board works as before.
SLACK_BOT_TOKEN=
# The backend, as the Slack app reaches it; the same value as INTAKE_TOKEN on the backend.
BOARD_API_URL=http://localhost:4000
INTAKE_TOKEN=
