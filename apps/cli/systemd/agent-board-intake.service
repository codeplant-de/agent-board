[Unit]
Description=agent-board intake: review requests to tasks

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# bin/intake takes the lock itself; exit 75 means another run holds it, which is not a failure.
ExecStart=%h/workspace/agent-board/apps/cli/bin/intake
SuccessExitStatus=75
TimeoutStartSec=300
