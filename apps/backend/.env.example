DATABASE_URL=postgresql://board:board@localhost:54331/board_dev
APP_DATABASE_URL=postgresql://board_app:board_app@localhost:54331/board_dev
TEST_DATABASE_URL=postgresql://board:board@localhost:54331/board_test
# Only for the first start after upgrading a database that already has tasks: the user who owns them.
# BACKFILL_OWNER=dev
PORT=4000
# No login: every request is this user, and anyone who reaches the port is them. Local development only, or a board nobody else can reach.
# The backend refuses to start with it next to PUBLIC_URL, PASSKEYS, SESSION_DAYS, SIGNUP_TOKEN, ALLOWED_GROUPS, OIDC_* or SAML_*:
# comment it out before setting any of them. DEV_AUTH_USER is an older name for it and is refused when NODE_ENV=production.
NO_LOGIN_USER=dev
# Login on: the board's address in the browser (http://localhost:5173 in dev); gives the passkey and redirect URLs.
# The settings below need it and need NO_LOGIN_USER above to be commented out.
# PUBLIC_URL=http://localhost:5173
# Passkeys are on by default; off removes the button.
# PASSKEYS=on
# Lets whoever holds it create an account with a passkey. Remove it once the accounts exist.
# SIGNUP_TOKEN=<32+ characters>
# Days a session lasts after its last use, 1 to 365.
# SESSION_DAYS=30
# OIDC: the redirect URI at the provider is PUBLIC_URL + /login/oidc. Optional: OIDC_SCOPES (default "openid profile email"),
# OIDC_USERNAME_CLAIM (preferred_username), OIDC_GROUPS_CLAIM (groups), OIDC_LABEL.
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=board
# OIDC_CLIENT_SECRET=...
# Groups of which an OIDC user needs one, comma-separated (a name with a space is one group). No default: unset means every
# account the provider lets through gets a board. Needs OIDC_ISSUER; the backend refuses to start without it.
# ALLOWED_GROUPS=admins
# SAML: the assertion consumer URL at the provider is PUBLIC_URL + /api/auth/saml/acs. Optional: SAML_IDP_CERT (inline),
# SAML_ISSUER (default PUBLIC_URL), SAML_USERNAME_ATTRIBUTE (default: the NameID), SAML_LABEL.
# SAML_ENTRY_POINT=https://idp.example.com/sso
# SAML_IDP_CERT_FILE=/run/secrets/idp.pem
# The newest CLI release (x.y.z) the machine API advertises; the image build sets it from apps/cli/package.json.
# CLI_VERSION=0.5.0
