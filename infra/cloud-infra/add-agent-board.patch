+    matchLabels:
+      app.kubernetes.io/name: slack
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: slack
+    spec:
+      imagePullSecrets:
+        - name: ghcr-pull
+      containers:
+        - name: slack
+          image: ghcr.io/codeplant-de/agent-board-slack:latest # {"$imagepolicy": "flux-system:agent-board-slack"}
+          # No Service, no ingress, no probes: it listens on no port. It dials out to Slack and to backend:4000.
+          envFrom:
+            - secretRef:
+                name: agent-board-slack-env
+          resources:
+            requests:
+              cpu: 10m
+              memory: 48Mi
+            limits:
+              memory: 128Mi
