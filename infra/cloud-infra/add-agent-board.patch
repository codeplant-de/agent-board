diff --git a/cluster/apps/agent-board/backend.yaml b/cluster/apps/agent-board/backend.yaml
new file mode 100644
index 0000000..a068226
--- /dev/null
+++ b/cluster/apps/agent-board/backend.yaml
@@ -0,0 +1,57 @@
+apiVersion: v1
+kind: Service
+metadata:
+  # The web container's Caddy proxies /trpc and /api to backend:4000; the Slack app calls /api/intake here.
+  name: backend
+spec:
+  selector:
+    app.kubernetes.io/name: backend
+  ports:
+    - name: http
+      port: 4000
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: backend
+spec:
+  replicas: 1
+  # Migrations run on start: one pod at a time.
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: backend
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: backend
+    spec:
+      imagePullSecrets:
+        - name: ghcr-pull
+      containers:
+        - name: backend
+          image: ghcr.io/codeplant-de/agent-board-backend:latest # {"$imagepolicy": "flux-system:agent-board-backend"}
+          envFrom:
+            - secretRef:
+                name: agent-board-env
+          ports:
+            - name: http
+              containerPort: 4000
+          readinessProbe:
+            httpGet:
+              path: /healthz
+              port: http
+            periodSeconds: 10
+          livenessProbe:
+            httpGet:
+              path: /healthz
+              port: http
+            periodSeconds: 30
+            failureThreshold: 4
+          resources:
+            requests:
+              cpu: 25m
+              memory: 96Mi
+            limits:
+              memory: 384Mi
diff --git a/cluster/apps/agent-board/env.sops.yaml.example b/cluster/apps/agent-board/env.sops.yaml.example
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/cluster/apps/agent-board/env.sops.yaml.example
@@ -0,0 +1,23 @@
+# Encrypt as env.sops.yaml (see cluster/README.md). DATABASE_URL uses the host "postgres" (the
+# Service name). The UI login is Authelia's; worker machines use tokens made on the board's Settings
+# page, stored hashed in Postgres. The only app secret is INTAKE_TOKEN.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: agent-board-env
+  namespace: agent-board
+stringData:
+  POSTGRES_USER: board
+  POSTGRES_PASSWORD: <fill-in>
+  POSTGRES_DB: board
+  NODE_ENV: production
+  PORT: "4000"
+  DATABASE_URL: postgresql://board:<fill-in>@postgres:5432/board
+  APP_DATABASE_URL: postgresql://board_app:<fill-in>@postgres:5432/board
+  # One-time: the username that owns the existing tasks. Remove after the first start.
+  BACKFILL_OWNER: <fill-in>
+  ALLOWED_GROUPS: admins
+  # The Slack app's access to the intake API: the same value as INTAKE_TOKEN in slack-env.sops.yaml (openssl rand -hex 32).
+  # BOARD_URL builds the links the Slack app hands out. Leave both out to run without Slack.
+  INTAKE_TOKEN: <fill-in>
+  BOARD_URL: https://board.codeplant.de
diff --git a/cluster/apps/agent-board/ingress.yaml b/cluster/apps/agent-board/ingress.yaml
new file mode 100644
index 0000000..6815d4c
--- /dev/null
+++ b/cluster/apps/agent-board/ingress.yaml
@@ -0,0 +1,64 @@
+apiVersion: cert-manager.io/v1
+kind: Certificate
+metadata:
+  name: board-codeplant-de
+spec:
+  secretName: board-codeplant-de-tls
+  dnsNames: [board.codeplant.de]
+  issuerRef:
+    kind: ClusterIssuer
+    name: letsencrypt-prod
+---
+# Browsers go through Authelia (access_control: group admins), which hands the backend the user in
+# Remote-* headers. The worker machines' CLI cannot do a browser login: it sends a
+# machine token in the Authorization header to /api/machine/*, which skips Authelia, and the backend
+# checks the token. That route matches nothing else, so a token never opens the UI. Both routes strip
+# the Remote-* headers first: the backend trusts them, so a client must never be able to send its own.
+apiVersion: traefik.io/v1alpha1
+kind: IngressRoute
+metadata:
+  name: agent-board
+  annotations:
+    gethomepage.dev/enabled: "true"
+    gethomepage.dev/instance: codeplant
+    gethomepage.dev/href: https://board.codeplant.de
+    gethomepage.dev/name: Agent Board
+    gethomepage.dev/description: Queue and conversations of the headless Claude workers
+    gethomepage.dev/group: Tools
+    gethomepage.dev/icon: mdi-view-column
+spec:
+  entryPoints: [websecure]
+  routes:
+    - kind: Rule
+      match: Host(`board.codeplant.de`) && PathPrefix(`/api/machine/`) && HeaderRegexp(`Authorization`, `^Bearer .+`)
+      priority: 20
+      middlewares:
+        - name: strip-sso-headers
+      services:
+        - name: web
+          port: 80
+    - kind: Rule
+      match: Host(`board.codeplant.de`)
+      priority: 10
+      middlewares:
+        - name: strip-sso-headers
+        - name: forward-auth
+          namespace: authelia
+      services:
+        - name: web
+          port: 80
+  tls:
+    secretName: board-codeplant-de-tls
+---
+apiVersion: traefik.io/v1alpha1
+kind: Middleware
+metadata:
+  name: strip-sso-headers
+spec:
+  headers:
+    # An empty value removes the header.
+    customRequestHeaders:
+      Remote-User: ""
+      Remote-Name: ""
+      Remote-Email: ""
+      Remote-Groups: ""
