{
  "name": "agent-board",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @agent-board/backend dev",
    "dev:frontend": "pnpm --filter @agent-board/frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @agent-board/backend db:generate",
    "db:migrate": "pnpm --filter @agent-board/backend db:migrate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  }
}
