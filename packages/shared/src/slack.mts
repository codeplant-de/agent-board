/** The longest text of a Slack inbox item, in characters. */
export const INBOX_TEXT_MAX = 20000;

/** Slack's team and user ids: upper-case letters and digits. */
export const SLACK_ID_PATTERN = /^[A-Z0-9]{2,32}$/;

/** The longest Slack handle kept to show next to a link. */
export const SLACK_NAME_MAX = 80;
